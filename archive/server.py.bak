# ============ 工具函数 ============

def random_int(min_val, max_val):
    return random.randint(min_val, max_val)

def random_choice(arr):
    return random.choice(arr)

def clamp(value, min_val=0, max_val=100):
    return max(min_val, min(max_val, value))

def format_money(amount):
    if amount >= 10000:
        return f"{amount/10000:.1f}万"
    return str(amount)

# ============ 游戏核心类 ============

class GameState:
    def __init__(self):
        self.data = {
            "name": "",
            "age": 18,
            "background": "1",
            "talent": "1",
            "personality": "1",
            "difficulty": "1",
            "money": 5000,
            "health": 80,
            "happiness": 70,
            "career": 20,
            "education": 0,
            "job": None,
            "year": 1,
            "isGameOver": False,
            "isDead": False,
            "deathReason": "",
            "achievements": [],
            "events": [],
            "timeline": [{"age": 18, "event": "开启人生旅程"}],
            "spouse": None,
            "children": [],
            "house": False,
            "pet": False,
            "countries": [],
            "stocks": 0,
            "turningPoints": 0,
            "consecutiveTurning": 0,
            "lifeLabels": [],
            "debt": 0,
            "keyChoices": {"age18": None, "age25": None, "age35": None, "age50": None},
        }
    
    def apply_effect(self, effect):
        if "money" in effect:
            self.data["money"] += effect["money"]
        if "health" in effect:
            self.data["health"] = clamp(self.data["health"] + effect["health"])
        if "happiness" in effect:
            self.data["happiness"] = clamp(self.data["happiness"] + effect["happiness"])
        if "career" in effect:
            self.data["career"] = clamp(self.data["career"] + effect["career"])
        if "house" in effect:
            self.data["house"] = True
        if "pet" in effect:
            self.data["pet"] = True
    
    def check_death(self):
        if self.data["health"] <= 0:
            if random.random() < 0.1:
                self.data["isDead"] = True
                self.data["deathReason"] = "因病去世"
                self.data["isGameOver"] = True
                return True
            else:
                self.trigger_turning_point()
        return False
    
    def check_turning_point(self):
        diff = DIFFICULTIES[self.data["difficulty"]]
        
        crisis_conditions = [
            self.data["health"] < diff["healthThreshold"],
            self.data["money"] < diff["moneyThreshold"],
            self.data["happiness"] < diff["happinessThreshold"]
        ]
        
        if any(crisis_conditions) and random.random() < diff["turningRate"] * 0.3:
            self.data["turningPoints"] += 1
            self.data["consecutiveTurning"] += 1
            
            if self.data["consecutiveTurning"] >= 2 and random.random() < 0.1:
                self.apply_effect({
                    "money": 100000,
                    "health": 50,
                    "happiness": 50,
                    "career": 30
                })
                self.data["lifeLabels"].append("逆袭者")
                return {
                    "type": "turning",
                    "title": "人生逆袭！",
                    "desc": "连续绝境触发超级转机！所有属性大幅提升！",
                    "effects": {"money": 100000, "health": 50, "happiness": 50, "career": 30}
                }
            
            event = random_choice(TURNING_POINT_EVENTS)
            self.apply_effect(event["effect"])
            
            self.data["timeline"].append({
                "age": self.data["age"],
                "event": f"🌟 转折: {event['title']}"
            })
            
            return {
                "type": "turning",
                "title": event["title"],
                "desc": event["desc"],
                "effects": event["effect"]
            }
        else:
            self.data["consecutiveTurning"] = 0
        
        return None
    
    def trigger_turning_point(self):
        event = random_choice(TURNING_POINT_EVENTS)
        self.apply_effect(event["effect"])
        self.data["turningPoints"] += 1
        
        self.data["timeline"].append({
            "age": self.data["age"],
            "event": f"🌟 转折: {event['title']}"
        })
    
    def next_year(self):
        self.data["year"] += 1
        self.data["age"] += 1
        
        health_change = -random_int(2, 8)
        happiness_change = -random_int(2, 8)
        
        pers = PERSONALITIES[self.data["personality"]]
        if "happinessDecay" in pers["effect"]:
            happiness_change *= pers["effect"]["happinessDecay"]
        
        talent = TALENTS[self.data["talent"]]
        if "healthDecay" in talent["effect"]:
            health_change *= talent["effect"]["healthDecay"]
        
        if self.data["pet"]:
            happiness_change += 5
        if self.data["house"]:
            happiness_change += 5
        
        self.data["health"] = clamp(self.data["health"] + health_change)
        self.data["happiness"] = clamp(self.data["happiness"] + happiness_change)
        
        career_change = random_int(-2, 5)
        if "careerBonus" in pers["effect"]:
            career_change *= (1 + pers["effect"]["careerBonus"])
        self.data["career"] = clamp(self.data["career"] + career_change)
        
        income = 100
        edu = EDUCATIONS[self.data["education"]]
        income = edu["baseIncome"] * (1 + self.data["career"] / 100)
        
        if self.data["job"] and self.data["job"] in JOBS:
            job_data = JOBS[self.data["job"]]
            income = job_data["income"] * (1 + self.data["career"] / 100)
            
            if random.random() < job_data["growth"]:
                self.data["career"] = clamp(self.data["career"] + 5)
            
            if random.random() < job_data["risk"] * 0.1:
                self.data["job"] = None
                self.data["timeline"].append({"age": self.data["age"], "event": "💸 失业了"})
                income = 0
        
        if "moneyBonus" in talent["effect"]:
            income *= (1 + talent["effect"]["moneyBonus"])
        
        self.data["money"] += int(income)
        
        if self.data["spouse"]:
            self.data["money"] -= 3000
            self.data["happiness"] = clamp(self.data["happiness"] + 5)
        
        for child in self.data["children"]:
            self.data["money"] -= 2000
        if self.data["children"]:
            self.data["happiness"] = clamp(self.data["happiness"] + len(self.data["children"]) * 3)
        
        self.data["timeline"].append({
            "age": self.data["age"],
            "event": f"年收入 {format_money(int(income))}"
        })
        
        if self.check_death():
            return {"type": "death", "reason": self.data["deathReason"]}
        
        turning = self.check_turning_point()
        if turning:
            return turning
        
        # 检查关键年龄事件
        if self.data["age"] in KEY_AGE_EVENTS:
            events = KEY_AGE_EVENTS[self.data["age"]]
            return {"type": "key_event", "event": random_choice(events)}
        
        # 30%概率随机普通事件
        if random.random() < 0.3:
            event = random_choice(NORMAL_EVENTS)
            return {"type": "normal_event", "event": event}
        
        return {"type": "normal", "message": f"年龄: {self.data['age']}岁"}
    
    def check_achievements(self):
        new_achievements = []
        for ach in ACHIEVEMENTS:
            if ach["id"] not in self.data["achievements"] and ach["condition"](self.data):
                self.data["achievements"].append(ach["id"])
                new_achievements.append(ach)
        return new_achievements
    
    def to_dict(self):
        return self.data.copy()


# 转机事件库
TURNING_POINT_EVENTS = [
    {"title": "贵人相助", "desc": "在你最困难的时候，有人伸出了援手", "effect": {"money": 30000, "happiness": 20}},
